cional de chefia de Estado e de Governo, execu\xe7\xe3o or\xe7ament\xe1ria da Uni\xe3o, lideran\xe7a de pol\xedticas nacionais, programas sociais e pol\xedtica externa soberana."}:'SENADOR'===n?{scope:`Legislativo Federal \u2022 ${c} \u2014 Bancada de ${t}`,competencia:`Representa\xe7\xe3o parit\xe1ria do Estado de ${t} no Congresso Nacional, aprova\xe7\xe3o de autoridades, julgamento de crimes de responsabilidade e proposi\xe7\xe3o de Leis e Emendas Constitucionais estruturantes.`}:'DEPUTADO_FEDERAL'===n?{scope:`Legislativo Federal \u2022 ${c} \u2014 Representante do Povo por ${t}`,competencia:`Vota\xe7\xe3o do Or\xe7amento Geral da Uni\xe3o (LOA/PPA), destina\xe7\xe3o de Emendas Parlamentares para os munic\xedpios de ${t}, proposi\xe7\xe3o legislativa e fiscaliza\xe7\xe3o rigorosa dos atos do Executivo Federal.`}:'DEPUTADO_ESTADUAL'===n?{scope:`Legislativo Estadual \u2022 ${c} \u2014 Assembleia Legislativa (${t})`,competencia:"Vota\xe7\xe3o do or\xe7amento estadual, cria\xe7\xe3o de leis estaduais, destina\xe7\xe3o de emendas impositivas regionais e fiscaliza\xe7\xe3o direta das secretarias e \xf3rg\xe3os do governo estadual."}:'PREFEITO'===n?{scope:`Executivo Municipal \u2022 ${c} de ${o?.municipality||'Munic\xedpio'}`,competencia:"Gest\xe3o direta dos servi\xe7os p\xfablicos municipais: aten\xe7\xe3o b\xe1sica de sa\xfade (postos e UPAs), educa\xe7\xe3o infantil e fundamental, transporte coletivo municipal e zeladoria urbana."}:{scope:`Mandato Representativo \u2022 ${c}`,competencia:'Atua\xe7\xe3o program\xe1tica e republicana na defesa dos interesses coletivos e da ordem constitucional.'}}function t(s,t){var c=s||{},l=(c.pillar||'p1').toLowerCase(),p=(c.title||c.name||'').toLowerCase();p.includes('empreendedor')||p.includes('mei')||p.includes('desonera')||p.includes('simples nacional')||p.includes('microcr\xe9dito')?l='p13':p.includes('trabalho')||p.includes('emprego')||p.includes('clt')||p.includes('trabalhador')||p.includes('sindic')?l='p12':p.includes('educa')||p.includes('escola')||p.includes('estudant')?l='p11':p.includes('sa\xfade')||p.includes('hospital')||p.includes('policl\xednica')?l='p9':p.includes('seguran\xe7a')||p.includes('pol\xedcia')||p.includes('mil\xedcia')?l='p10':p.includes('transporte')||p.includes('mobilidade')||p.includes('ind\xfastria')||p.includes('tecnologia')?l='p5':p.includes('saneamento')||p.includes('ambiente')||p.includes('ba\xeda')||p.includes('clima')?l='p3':p.includes('habita')||p.includes('moradia')||p.includes('comunidade')||p.includes('fome')?l='p1':(p.includes('renda')||p.includes('sal\xe1rio')||p.includes('tribut'))&&(l='p6');var u=o[l]||{label:(c.pillar||'Geral').toUpperCase(),icon:'\ud83d\udccc'},b=c.title||c.name||c.text||`Proposta Estrat\xe9gica sobre ${u.label}`,v=c.description||c.text||c.details||'Esta proposta comp\xf5e o programa priorit\xe1rio de mandato do candidato registrado na Justi\xe7a Eleitoral.',f=t?.state||'RJ',E=t?.name||t?.socialName||'O(A) candidato(a)',S=(t?.cargo||'').toUpperCase(),z=n(t),h=z.scope,R=z.competencia;return c.metasAcoes&&Array.isArray(c.metasAcoes)&&c.metasAcoes.length>0&&c.diagnostico?{pillar:l,pillarInfo:c.pillarInfo||u,title:b,description:v,mandatoScope:c.mandatoScope||h,competenciaMandato:c.competenciaMandato||R,diagnostico:c.diagnostico,diretrizes:c.diretrizes||v,metasAcoes:c.metasAcoes,beneficiarios:c.beneficiarios||'Popula\xe7\xe3o em geral e comunidades atendidas.',abrangencia:c.abrangencia||`\xc2mbito de atua\xe7\xe3o do mandato em ${f}.`,impacto:c.impacto||'Melhoria na presta\xe7\xe3o dos servi\xe7os p\xfablicos e cidadania.',indicadoresSucesso:c.indicadoresSucesso,viabilidadeOrcamentaria:c.viabilidadeOrcamentaria||'Dota\xe7\xe3o or\xe7ament\xe1ria pr\xf3pria do mandato.',translatedText:c.translatedText||v}:('p11'===l||p.includes('educa')||p.includes('escola'))&&'GOVERNADOR'===S?{pillar:'p11',pillarInfo:{label:'Educa\xe7\xe3o',icon:'\ud83c\udf93'},title:b,description:v,mandatoScope:h,competenciaMandato:R,diagnostico:`A rede p\xfablica estadual de ${f} possui unidades com car\xeancia de manuten\xe7\xe3o predial, aus\xeancia de climatiza\xe7\xe3o adequada e desigualdade no acesso a tecnologias digitais, impactando a frequ\xeancia e o rendimento escolar dos estudantes no Ensino M\xe9dio.`,diretrizes:"Garantir padr\xe3o integrado de dignidade predial, climatiza\xe7\xe3o em 100% das unidades escolares e inclus\xe3o digital irrestrita como pilar estruturante de reten\xe7\xe3o escolar e atratividade pedag\xf3gica para os jovens.",metasAcoes:["Reforma f\xedsica, hidr\xe1ulica e el\xe9trica com instala\xe7\xe3o de climatiza\xe7\xe3o completa nas salas de aula de toda a rede estadual ao longo do quadri\xeanio.","Conex\xe3o via banda larga de alta velocidade e moderniza\xe7\xe3o dos laborat\xf3rios de inform\xe1tica e rob\xf3tica em todas as escolas estaduais.","Descentraliza\xe7\xe3o de recursos de manuten\xe7\xe3o direta para a gest\xe3o escolar ('Autonomia na Escola') para reparos emergenciais \xe1geis.","Articula\xe7\xe3o de programas de ensino t\xe9cnico e profissionalizante articulados ao Ensino M\xe9dio integrado e amplia\xe7\xe3o de bolsas de perman\xeancia."],beneficiarios:`Mais de 650 mil estudantes do Ensino M\xe9dio e Fundamental II, professores, equipes pedag\xf3gicas e comunidades escolares de todos os 92 munic\xedpios de ${f}.`,abrangencia:`Territ\xf3rio integral do Estado de ${f}, com prioridade inicial para \xe1reas de maior vulnerabilidade social da Baixada Fluminense, Regi\xe3o Metropolitana e Interior.`,impacto:"Eleva\xe7\xe3o consistente do IDEB estadual, erradica\xe7\xe3o do abandono escolar juvenil, melhoria nas condi\xe7\xf5es de trabalho docente e forma\xe7\xe3o pr\xe1tica para o mercado de trabalho.",indicadoresSucesso:"Taxa de escolas climatizadas, velocidade m\xe9dia de conectividade escolar e redu\xe7\xe3o percentual da taxa de evas\xe3o escolar no Ensino M\xe9dio.",viabilidadeOrcamentaria:"Aplica\xe7\xe3o do percentual constitucional vinculante de 25% da receita l\xedquida estadual em Educa\xe7\xe3o, complementa\xe7\xe3o do FUNDEB e capta\xe7\xe3o de recursos via conv\xeanios federais (MEC/FNDE).",translatedText:"O que muda para voc\xea e sua fam\xedlia: Escolas estaduais com ar-condicionado em todas as salas, computadores com internet r\xe1pida funcionando e pr\xe9dios reformados. Seus filhos ter\xe3o estrutura moderna e acolhedora para estudar com dignidade e seguran\xe7a."}:('p9'===l||p.includes('sa\xfade')||p.includes('hospital')||p.includes('policl\xednica'))&&'GOVERNADOR'===S?{pillar:'p9',pillarInfo:{label:'Sa\xfade P\xfablica',icon:'\ud83e\ude7a'},title:b,description:v,mandatoScope:h,competenciaMandato:R,diagnostico:"A excessiva centraliza\xe7\xe3o dos servi\xe7os de sa\xfade de m\xe9dia e alta complexidade na capital for\xe7a milhares de moradores da Baixada, Regi\xe3o Serrana e Interior a viagens exaustivas, sobrecarregando hospitais centrais e gerando longas filas na regula\xe7\xe3o (SISREG).",diretrizes:`Descentralizar o atendimento m\xe9dico especializado atrav\xe9s da implanta\xe7\xe3o de Policl\xednicas e Centros Integrados de Diagn\xf3stico nas regi\xf5es estrat\xe9gicas do Estado de ${f}, integradas com telemedicina e regula\xe7\xe3o unificada.`,metasAcoes:["Constru\xe7\xe3o e operacionaliza\xe7\xe3o de uma rede de Policl\xednicas Regionais em cons\xf3rcio com os munic\xedpios do Interior e Baixada Fluminense.","Programa estadual para zerar a fila de cirurgias eletivas (ortopedia, catarata, h\xe9rnia e ves\xedcula) mediante mutir\xf5es e amplia\xe7\xe3o de turnos hospitalares.","Implanta\xe7\xe3o do prontu\xe1rio eletr\xf4nico unificado e sistema inteligente de regula\xe7\xe3o de vagas para acabar com a burocracia do SISREG estadual.","Garantia do abastecimento ininterrupto de medicamentos essenciais e de alto custo nas farm\xe1cias estaduais."],beneficiarios:"Usu\xe1rios do Sistema \xdanico de Sa\xfade (SUS), especialmente cidad\xe3os que necessitam de consultas especializadas, exames diagn\xf3sticos e cirurgias de m\xe9dia/alta complexidade.",abrangencia:`Todos os 92 munic\xedpios do Estado de ${f}, com foco descentralizado no Interior, Baixada Fluminense, Norte, Noroeste e Sul do Estado.`,impacto:"Redu\xe7\xe3o dr\xe1stica do tempo de espera para consultas com especialistas e exames complexos; atendimento digno perto da casa do paciente, sem necessidade de deslocamento \xe0 capital.",indicadoresSucesso:"Tempo m\xe9dio de espera na regula\xe7\xe3o para cirurgias eletivas e taxa de resolutividade dos centros m\xe9dicos regionais.",viabilidadeOrcamentaria:`Fundo Estadual de Sa\xfade de ${f}, aplica\xe7\xe3o m\xednima de 12% da receita corrente do Estado em Sa\xfade, transfer\xeancias federais do SUS e cons\xf3rcios intermunicipais.`,translatedText:"O que muda para voc\xea: Voc\xea n\xe3o precisar\xe1 mais acordar de madrugada nem pegar van para fazer exame ou consulta com especialista na capital. Haver\xe1 policl\xednicas modernas perto da sua regi\xe3o para fazer consultas, exames e cirurgias com rapidez e respeito."}:'p10'===l||p.includes('seguran\xe7a')||p.includes('pol\xedcia')||p.includes('mil\xedcia')?{pillar:'p10',pillarInfo:{label:'Seguran\xe7a P\xfablica',icon:'\ud83d\ude93'},title:b,description:v,mandatoScope:h,competenciaMandato:R,diagnostico:`A expans\xe3o das fac\xe7\xf5es criminosas e mil\xedcias afeta diretamente a tranquilidade das fam\xedlias, o com\xe9rcio local e a livre circula\xe7\xe3o de pessoas em comunidades e centros urbanos de ${f}.`,diretrizes:"Moderniza\xe7\xe3o da seguran\xe7a p\xfablica pautada em intelig\xeancia financeira, integra\xe7\xe3o de dados entre as for\xe7as policiais, valoriza\xe7\xe3o dos agentes da lei e a\xe7\xf5es de presen\xe7a comunit\xe1ria com servi\xe7os p\xfablicos.",metasAcoes:["Cria\xe7\xe3o de For\xe7a-Tarefa Especial de Intelig\xeancia e asfixia patrimonial contra a lavagem de dinheiro de mil\xedcias e narcotr\xe1fico.","Moderniza\xe7\xe3o dos centros de per\xedcia t\xe9cnica cient\xedfica e compra de equipamentos bal\xedsticos e de prote\xe7\xe3o individual de \xfaltima gera\xe7\xe3o.","Realiza\xe7\xe3o de concursos p\xfablicos peri\xf3dicos e plano de valoriza\xe7\xe3o remunerat\xf3ria das carreiras policiais e penais.","Implanta\xe7\xe3o de programas integrados de urbaniza\xe7\xe3o, ilumina\xe7\xe3o LED de alta pot\xeancia e c\xe2meras inteligentes nas \xe1reas de maior \xedndice de criminalidade."],beneficiarios:`Cidad\xe3os, trabalhadores, comerciantes, pedestres e profissionais das for\xe7as de seguran\xe7a p\xfablica de ${f}.`,abrangencia:`Centros urbanos, rodovias estaduais, regi\xf5es metropolitanas e munic\xedpios do interior de ${f}.`,impacto:"Queda nos \xedndices de letalidade violenta e roubos de rua/carga, recupera\xe7\xe3o de territ\xf3rios dominados pelo crime e restabelecimento da paz social.",indicadoresSucesso:"Redu\xe7\xe3o nas taxas de homic\xeddio doloso e roubo de rua por 100 mil habitantes registradas pelo ISP/\xf3rg\xe3os oficiais.",viabilidadeOrcamentaria:`Fundo Estadual de Seguran\xe7a P\xfablica de ${f}, transfer\xeancias do Fundo Nacional de Seguran\xe7a P\xfablica (Minist\xe9rio da Justi\xe7a) e dota\xe7\xf5es do Tesouro.`,translatedText:"O que muda para o cidad\xe3o: Mais policiais nas ruas bem equipados e valorizados, intelig\xeancia para prender os chefes das mil\xedcias e do tr\xe1fico, e bairros iluminados e vigiados para voc\xea ir e voltar do trabalho com tranquilidade."}:'p5'===l||p.includes('transporte')||p.includes('mobilidade')||p.includes('ind\xfastria')||p.includes('infraestrutura')?{pillar:'p5',pillarInfo:{label:'Reindustrializa\xe7\xe3o & Mobilidade',icon:'\ud83d\ude87'},title:b,description:v,mandatoScope:h,competenciaMandato:R,diagnostico:"A precariedade cr\xf4nica do sistema de trens metropolitanos (SuperVia), barcas e metr\xf4 penaliza diariamente milh\xf5es de trabalhadores com atrasos, superlota\xe7\xe3o e tarifas elevadas, al\xe9m de limitar a atra\xe7\xe3o de novas f\xe1bricas e empreendimentos.",diretrizes:"Reestrutura\xe7\xe3o profunda do transporte sobre trilhos e aquavi\xe1rio, integra\xe7\xe3o tarif\xe1ria metropolitana (Bilhete \xdanico com custo acess\xedvel) e reindustrializa\xe7\xe3o focada em cadeias de transi\xe7\xe3o energ\xe9tica e inova\xe7\xe3o.",metasAcoes:["Retomada da gest\xe3o ou reformula\xe7\xe3o total do contrato de concess\xe3o da SuperVia e Barcas com investimentos obrigat\xf3rios em novos trens refrigerados e esta\xe7\xf5es acess\xedveis.","Expans\xe3o da malha metrovi\xe1ria com prioridade para a Linha 3 (Niter\xf3i - S\xe3o Gon\xe7alo - Itabora\xed) e extens\xe3o da Linha 2.","Cria\xe7\xe3o de Polos de Desenvolvimento Industrial no Interior e na Baixada Fluminense com incentivos tribut\xe1rios para ind\xfastrias farmac\xeauticas, qu\xedmicas e de log\xedstica.","Garantia do Bilhete \xdanico Intermunicipal integrado com vans legalizadas, \xf4nibus, barcas, metr\xf4 e trem."],beneficiarios:"Milh\xf5es de passageiros di\xe1rios da Regi\xe3o Metropolitana, Baixada Fluminense, Leste Fluminense e trabalhadores das ind\xfastrias estaduais.",abrangencia:"Regi\xe3o Metropolitana do Rio de Janeiro e principais eixos rodovi\xe1rios e ferrovi\xe1rios do Estado.",impacto:"Redu\xe7\xe3o do tempo di\xe1rio de deslocamento do trabalhador em at\xe9 40%, transporte com ar-condicionado e atra\xe7\xe3o de novos investimentos produtivos para o Estado.",indicadoresSucesso:"Intervalo m\xe9dio entre viagens nos trens metropolitanos e n\xfamero de novos postos formais de trabalho industrial gerados.",viabilidadeOrcamentaria:"Dota\xe7\xf5es do Tesouro Estadual, Fundo Estadual de Transportes, opera\xe7\xf5es de cr\xe9dito junto ao BNDES e repasses do Novo PAC Federal.",translatedText:"O que muda para voc\xea: Trens e barcas com ar-condicionado funcionando, sem atrasos constantes, integra\xe7\xe3o mais barata com o metr\xf4 e \xf4nibus para voc\xea chegar mais r\xe1pido ao trabalho e voltar mais cedo para a sua fam\xedlia."}:'p3'===l||p.includes('saneamento')||p.includes('ambiente')||p.includes('ba\xeda')||p.includes('\xe1gua')?{pillar:'p3',pillarInfo:{label:'Desenvolvimento Sustent\xe1vel',icon:'\ud83c\udf3f'},title:b,description:v,mandatoScope:h,competenciaMandato:R,diagnostico:"Milh\xf5es de moradores da Baixada Fluminense, S\xe3o Gon\xe7alo e periferias ainda convivem com esgoto a c\xe9u aberto, falta de \xe1gua tratada regular e polui\xe7\xe3o hist\xf3rica da Ba\xeda de Guanabara e do Rio Para\xedba do Sul.",diretrizes:"Fiscaliza\xe7\xe3o rigorosa e acelera\xe7\xe3o do cumprimento das metas contratuais de universaliza\xe7\xe3o do saneamento b\xe1sico (\xe1gua e esgoto) at\xe9 2030, associadas \xe0 transi\xe7\xe3o ecol\xf3gica e seguran\xe7a h\xeddrica.",metasAcoes:["Fiscaliza\xe7\xe3o cont\xednua pela ag\xeancia reguladora estadual (Agenersa) para cumprimento das metas de 99% de \xe1gua tratada e 90% de esgoto coletado/tratado.","Implementa\xe7\xe3o do Cintur\xe3o de Coleta e Efluentes para despolui\xe7\xe3o definitiva das bacias que des\xe1guam na Ba\xeda de Guanabara e Sistema Lagunar.","Programa estadual de conten\xe7\xe3o de encostas e drenagem urbana em \xe1reas de alto risco geol\xf3gico para prevenir trag\xe9dias clim\xe1ticas em Petr\xf3polis, Teres\xf3polis e favelas.","Incentivo \xe0 gera\xe7\xe3o de energia solar fotovoltaica em pr\xe9dios p\xfablicos e cooperativas comunit\xe1rias."],beneficiarios:"Popula\xe7\xe3o de todos os munic\xedpios fluminenses, pescadores artesanais, comunidades ribeirinhas e moradores de encostas e \xe1reas vulner\xe1veis.",abrangencia:"Bacia da Ba\xeda de Guanabara, Regi\xe3o Serrana, Baixada Fluminense e litoral do Estado.",impacto:"Elimina\xe7\xe3o do esgoto a c\xe9u aberto, redu\xe7\xe3o de doen\xe7as de veicula\xe7\xe3o h\xeddrica, recupera\xe7\xe3o da vida marinha e prote\xe7\xe3o de vidas contra enchentes e deslizamentos.",indicadoresSucesso:"\xcdndice de cobertura de coleta e tratamento de esgoto e volume de res\xedduos s\xf3lidos recolhidos nas \xe1guas da Ba\xeda.",viabilidadeOrcamentaria:"Investimentos vinculados aos contratos de concess\xe3o dos servi\xe7os de saneamento, Fundo Estadual de Conserva\xe7\xe3o Ambiental (Fecam) e recursos federais.",translatedText:"O que muda para voc\xea: Esgoto canalizado e tratado na sua rua, fim do mau cheiro nos c\xf3rregos perto de casa, \xe1gua limpa na torneira e obras nas encostas para voc\xea dormir em paz nas noites de chuva forte."}:'p1'===l||p.includes('habita')||p.includes('moradia')||p.includes('comunidade')||p.includes('fome')?{pillar:'p1',pillarInfo:{label:'Bem-Estar & Habita\xe7\xe3o',icon:'\ud83e\udd56'},title:b,description:v,mandatoScope:h,competenciaMandato:R,diagnostico:"O d\xe9ficit habitacional e a precariedade urban\xedstica afetam mais de 1,5 milh\xe3o de pessoas no Estado, perpetuando bols\xf5es de pobreza extrema sem acesso a servi\xe7os urbanos essenciais e regulariza\xe7\xe3o de seus lares.",diretrizes:"Reurbaniza\xe7\xe3o participativa de favelas e comunidades, regulariza\xe7\xe3o fundi\xe1ria de moradias com entrega de escrituras definitivas e combate frontal \xe0 inseguran\xe7a alimentar.",metasAcoes:["Implanta\xe7\xe3o do Programa Estadual de Urbaniza\xe7\xe3o de Favelas ('Bairro Integrado') com asfalto, saneamento, pra\xe7as, quadras e ilumina\xe7\xe3o LED.","Entrega de 100 mil t\xedtulos de regulariza\xe7\xe3o fundi\xe1ria e t\xedtulos de propriedade gratuita para fam\xedlias de baixa renda.","Constru\xe7\xe3o e reabertura de Restaurantes Populares estaduais servindo caf\xe9 da manh\xe3 a R$ 0,50 e almo\xe7o a R$ 1,00 nas cidades mais populosas.","Fortalecimento da rede de CRAS/CREAS em apoio aos munic\xedpios para atendimento de fam\xedlias em extrema vulnerabilidade."],beneficiarios:"Fam\xedlias residentes em comunidades, assentamentos informais, periferias urbanas e cidad\xe3os em situa\xe7\xe3o de vulnerabilidade socioecon\xf4mica.",abrangencia:"Comunidades e bairros populares da Regi\xe3o Metropolitana, Baixada e periferias de cidades-polo do Estado.",impacto:"Seguran\xe7a jur\xeddica da posse do im\xf3vel familiar, valoriza\xe7\xe3o do patrim\xf4nio das comunidades, nutri\xe7\xe3o b\xe1sica garantida e inclus\xe3o na cidadania plena.",indicadoresSucesso:"N\xfamero de t\xedtulos de propriedade lavrados e entregues e refei\xe7\xf5es balanceadas distribu\xeddas nos Restaurantes Populares.",viabilidadeOrcamentaria:"Fundo Estadual de Habita\xe7\xe3o de Interesse Social (FEHIS), Fundo de Combate \xe0 Pobreza (FCP) e parcerias com o Minha Casa, Minha Vida.",translatedText:"O que muda para voc\xea: O t\xedtulo de propriedade definitivo da sua casa registrado em cart\xf3rio sem custo, asfalto, luz e saneamento na sua comunidade, e restaurante popular com refei\xe7\xe3o barata e de qualidade no seu bairro."}:'p6'===l||'p2'===l||p.includes('renda')||p.includes('trabalho')||p.includes('emprego')||p.includes('microcr\xe9dito')?{pillar:'p6',pillarInfo:{label:'Distribui\xe7\xe3o de Renda & Emprego',icon:'\ud83d\udcb0'},title:b,description:v,mandatoScope:h,competenciaMandato:R,diagnostico:"A elevada taxa de desemprego e subocupa\xe7\xe3o entre os jovens fluminenses exige pol\xedticas arrojadas de atra\xe7\xe3o de investimentos, forma\xe7\xe3o pr\xe1tica para novas tecnologias e incentivo direto aos microempreendedores de bairro.",diretrizes:"Est\xedmulo \xe0 cria\xe7\xe3o de vagas de trabalho formal, expans\xe3o do microcr\xe9dito orientado a juros zero para neg\xf3cios de periferia e qualifica\xe7\xe3o t\xe9cnica articulada \xe0s demandas do mercado.",metasAcoes:["Cria\xe7\xe3o do Programa 'Primeiro Passo RJ': subs\xeddio estadual para empresas que contratarem jovens de 18 a 29 anos egressos da rede p\xfablica estadual.","Linhas de microcr\xe9dito produtivo orientado (AgeRio) com car\xeancia e taxa subsidiada para aut\xf4nomos, ambulantes, artes\xe3os e MEIs.","Capacita\xe7\xe3o profissional gratuita em tecnologia, intelig\xeancia artificial, programa\xe7\xe3o e com\xe9rcio eletr\xf4nico nos centros vocacionais estaduais (FAETEC).","Desburocratiza\xe7\xe3o da abertura de empresas com alvar\xe1 digital estadual em at\xe9 24 horas para atividades de baixo risco."],beneficiarios:"Jovens em busca do primeiro emprego, trabalhadores informais, mulheres empreendedoras, micro e pequenos empres\xe1rios fluminenses.",abrangencia:`Todos os munic\xedpios do Estado de ${f}.`,impacto:"Inser\xe7\xe3o de mais de 80 mil jovens no mercado de trabalho formal, fortalecimento do com\xe9rcio comunit\xe1rio e aumento da renda m\xe9dia das fam\xedlias.",indicadoresSucesso:"Taxa de emprego com carteira assinada gerada pelo Caged no Estado e volume de microcr\xe9dito concedido pela AgeRio.",viabilidadeOrcamentaria:"Ag\xeancia Estadual de Fomento (AgeRio), Fundo Estadual de Trabalho e Renda e parcerias com o Sistema S (Senai/Sebrae/Senac).",translatedText:"O que muda para voc\xea: Cr\xe9dito r\xe1pido e com juros baixos para voc\xea comprar material e fazer seu neg\xf3cio crescer, cursos gratuitos de profiss\xf5es modernas na Faetec e incentivo para as empresas darem a primeira oportunidade de emprego com carteira assinada para os jovens."}:{pillar:l,pillarInfo:u,title:b,description:v,mandatoScope:h,competenciaMandato:R,diagnostico:`A \xe1rea correspondente a '${u.label}' exige solu\xe7\xf5es modernas, efici\xeancia administrativa e compromisso com o interesse p\xfablico para superar defasagens hist\xf3ricas em ${f}.`,diretrizes:"Desenvolver iniciativas coordenadas com planejamento estrat\xe9gico, transpar\xeancia ativa e participa\xe7\xe3o social para que a pol\xedtica p\xfablica atinja quem mais precisa.",metasAcoes:[`Elabora\xe7\xe3o e execu\xe7\xe3o de plano de metas com cronograma p\xfablico de acompanhamento durante o mandato de ${E}.`,"Moderniza\xe7\xe3o de processos operacionais com redu\xe7\xe3o de entraves burocr\xe1ticos para os cidad\xe3os.","Articula\xe7\xe3o institucional para destina\xe7\xe3o de recursos or\xe7ament\xe1rios priorit\xe1rios \xe0 execu\xe7\xe3o da proposta.","Monitoramento cont\xednuo dos resultados com canais abertos de ouvidoria e controle social."],beneficiarios:`Popula\xe7\xe3o do Estado de ${f}, com \xeanfase nos usu\xe1rios dos servi\xe7os p\xfablicos e segmentos sociais diretamente impactados.`,abrangencia:`Territ\xf3rio de ${f}, com foco nas demandas regionais priorit\xe1rias.`,impacto:"Melhoria quantitativa e qualitativa na entrega de servi\xe7os p\xfablicos, transpar\xeancia e valoriza\xe7\xe3o da cidadania.",indicadoresSucesso:"Cumprimento do cronograma de entregas estabelecido no plano de mandato registrado.",viabilidadeOrcamentaria:"Previs\xe3o nas diretrizes or\xe7ament\xe1rias (LDO/LOA), dota\xe7\xf5es ordin\xe1rias e capta\xe7\xe3o de recursos intergovernamentais.",translatedText:"O que muda para o cidad\xe3o: Uma proposta s\xe9ria com metas claras que o candidato se compromete a fiscalizar e executar no mandato, melhorando a vida da popula\xe7\xe3o com transpar\xeancia e responsabilidade com o dinheiro p\xfablico."}}function c(o){var s=(o.title||o.name||o.text||'').toLowerCase();return s.includes('empreendedor')||s.includes('mei')||s.includes('desonera')||s.includes('simples nacional')||s.includes('microcr\xe9dito')?'p13':s.includes('trabalho')||s.includes('emprego')||s.includes('clt')||s.includes('trabalhador')||s.includes('sindic')?'p12':s.includes('educa')||s.includes('escola')||s.includes('estudant')?'p11':s.includes('sa\xfade')||s.includes('saude')||s.includes('hospital')||s.includes('policl\xednica')||s.includes('policlinica')||s.includes('sus')?'p9':s.includes('seguran\xe7a')||s.includes('seguranca')||s.includes('pol\xedcia')||s.includes('policia')||s.includes('mil\xedcia')||s.includes('milicia')?'p10':s.includes('transporte')||s.includes('mobilidade')||s.includes('ind\xfastria')||s.includes('industria')||s.includes('supervia')||s.includes('metr\xf4')||s.includes('metro')||s.includes('trem')||s.includes('barca')?'p5':s.includes('saneamento')||s.includes('ambiente')||s.includes('ba\xeda')||s.includes('baia')||s.includes('clima')||s.includes('\xe1gua')||s.includes('agua')||s.includes('esgoto')?'p3':s.includes('habita')||s.includes('moradia')||s.includes('comunidade')||s.includes('fome')||s.includes('restaurante')?'p1':s.includes('renda')||s.includes('sal\xe1rio')||s.includes('salario')||s.includes('tribut')?'p6':(o.pillar||'').toLowerCase()}},903,[900]);
__d(function(g,r,i,a,m,e,d){function o(o){return o>=90?'Alt\xedssima':o>=80?'Alta':o>=65?'Consistente':o>=50?'Moderada':'Cr\xedtica'}Object.defineProperty(e,"__esModule",{value:!0}),e.buildPillarJustificativa=function(s){var t,n,c=Math.min(100,Math.max(0,Math.round(s.score))),p=100-c,l=s.pillarId;(s.party||'').toUpperCase(),s.candidateName;c>=90?(t=Math.min(100,c+2),n=Math.max(0,c-1)):c>=80?(t=Math.min(100,c+1),n=Math.max(0,c-2)):c>=65?(t=Math.min(100,c+2),n=c):(t=Math.max(10,c-3),n=Math.min(100,c+4));var u=Math.min(100,Math.max(0,Math.round((c-.4*t-.3*n)/.3))),v='',f='',b=[],h='',z='',A='';switch(l){case'p1':c>=85?(v=`O \xedndice de ${c}% expressa comprometimento exemplar com a seguridade social, refletido na defesa intransigente da universaliza\xe7\xe3o do saneamento p\xfablico, amplia\xe7\xe3o de recursos para o SUAS e garantia de habita\xe7\xe3o digna para popula\xe7\xf5es perif\xe9ricas.`,f=`O afastamento de 100% (-${p}% de gap) decorre de concess\xf5es em composi\xe7\xf5es or\xe7ament\xe1rias e absten\xe7\xf5es pontuais em mat\xe9rias de regula\xe7\xe3o de terceiriza\xe7\xf5es nos servi\xe7os municipais de acolhimento social.`,b=['Ades\xe3o pontual a acordos de bancada que limitaram o ritmo de expans\xe3o do or\xe7amento habitacional para faixas de menor renda.','Menor volume de proposi\xe7\xf5es legislativas de autoria pr\xf3pria voltadas \xe0 fiscaliza\xe7\xe3o direta de entidades assistenciais conveniadas.'],h='Vota\xe7\xf5es 100% favor\xe1veis \xe0 recomposi\xe7\xe3o do Fundo Nacional de Assist\xeancia Social e saneamento p\xfablico.',z='Pronunciamentos frequentes e enf\xe1ticos na tribuna em defesa do acolhimento comunit\xe1rio e combate \xe0 pobreza extrema.',A='Apresenta\xe7\xe3o e apoio ativo a emendas or\xe7ament\xe1rias priorit\xe1rias destinadas \xe0 infraestrutura urbana em favelas e creches.'):(v=`A nota de ${c}% reflete atua\xe7\xe3o favor\xe1vel \xe0 prote\xe7\xe3o social geral, com votos de bancada em mat\xe9rias de assist\xeancia, por\xe9m com menor volume de iniciativas legislativas pr\xf3prias exclusivas nesta tem\xe1tica.`,f=`O afastamento de ${p}% em rela\xe7\xe3o ao comprometimento pleno reflete a aus\xeancia de protagonismo em pautas assistenciais estruturantes e apoio pragm\xe1tico a limites fiscais restritivos.`,b=['Aus\xeancia de projetos de lei priorit\xe1rios de autoria pr\xf3pria nas \xe1reas de habita\xe7\xe3o popular e saneamento em periferias.','Votos de absten\xe7\xe3o ou alinhamento com governos em medidas de contingenciamento de verbas do Sistema \xdanico de Assist\xeancia Social (Suas).'],h='Vota\xe7\xf5es alinhadas com as diretrizes sociais essenciais, com raras absten\xe7\xf5es em mat\xe9rias or\xe7ament\xe1rias.',z='Discursos p\xfablicos apoiando a rede de assist\xeancia social em debates or\xe7ament\xe1rios.',A='Apoio institucional e di\xe1logo com entidades assistenciais locais.');break;case'p2':c>=85?(v=`Comprometimento alt\xedssimo (${c}%) comprovado pela defesa inegoci\xe1vel da Lei de Igualdade Salarial entre homens e mulheres, renova\xe7\xe3o e amplia\xe7\xe3o da Lei de Cotas no servi\xe7o p\xfablico e enfrentamento combativo a qualquer forma de discrimina\xe7\xe3o e viol\xeancia pol\xedtica.`,f=`O candidato est\xe1 afastado em ${p}% da pontua\xe7\xe3o m\xe1xima em raz\xe3o de compromissos t\xe1ticos de bancada em vota\xe7\xf5es penais e aus\xeancia de relatorias exclusivas em direitos difusos.`,b=['Votos ou absten\xe7\xf5es espor\xe1dicas em altera\xe7\xf5es do C\xf3digo de Processo Penal que suscitaram ressalvas de entidades de direitos humanos.','Concentra\xe7\xe3o priorit\xe1ria da atua\xe7\xe3o parlamentar em temas econ\xf4micos, reduzindo pronunciamentos sobre diversidade em momentos de grande polariza\xe7\xe3o.'],h='Votos nominais favor\xe1veis em todas as mat\xe9rias de combate ao racismo estrutural, direitos das mulheres e popula\xe7\xe3o LGBTQIA+.',z='Discursos contundentes em plen\xe1rio contra retrocessos nos direitos civis e defesa irrestrita dos direitos humanos fundamentais.',A='Articula\xe7\xe3o de frentes parlamentares e apoio irrestrito a conselhos de direitos humanos e movimentos sociais organizados.'):(v=`Classifica\xe7\xe3o de ${c}% indica converg\xeancia geral nas pautas de direitos civis, com ades\xe3o aos votos de bancada e manifesta\xe7\xf5es p\xfablicas de rep\xfadio a viol\xeancias sistem\xe1ticas.`,f=`O distanciamento de ${p}% dos 100% de comprometimento \xe9 motivado por uma postura moderada e cautelosa, evitando confrontar temas controversos de costumes e seguran\xe7a p\xfablica.`,b=['Posicionamentos discretos em mat\xe9rias legislativas de enfrentamento \xe0 viol\xeancia policial e amplia\xe7\xe3o de direitos LGBTQIA+.','Ades\xe3o autom\xe1tica a acordos partid\xe1rios que desidrataram medidas mais duras de combate ao racismo institucional.'],h='Acompanhamento da bancada nas vota\xe7\xf5es de igualdade salarial e cotas sociais.',z='Posicionamentos p\xfablicos favor\xe1veis \xe0 equidade e respeito \xe0 diversidade cidad\xe3.',A='Participa\xe7\xe3o em comiss\xf5es tem\xe1ticas relacionadas a direitos humanos e cidadania.');break;case'p3':c>=85?(v=`\xcdndice de ${c}% de vanguarda ambiental: hist\xf3rico de votos sistematicamente contr\xe1rios ao Marco Temporal e \xe0 flexibiliza\xe7\xe3o de agrot\xf3xicos, apoio or\xe7ament\xe1rio expresso aos \xf3rg\xe3os de fiscaliza\xe7\xe3o (Ibama/ICMBio) e lideran\xe7a na agenda de transi\xe7\xe3o energ\xe9tica justa.`,f=`O afastamento de 100% (-${p}% de gap) decorre de apoios pontuais a projetos de infraestrutura regional e log\xedstica rodovi\xe1ria que cont\xeam impactos socioambientais sens\xedveis.`,b=['Apoio a concess\xf5es e licenciamentos de grandes rodovias ou ferrovias de escoamento produtivo em \xe1reas de amortecimento ambiental.','Negocia\xe7\xf5es de flexibiliza\xe7\xe3o de prazos para regulariza\xe7\xe3o fundi\xe1ria de pequenos produtores rurais em \xe1reas de preserva\xe7\xe3o.'],h='Vota\xe7\xf5es nominais exemplares contra a degrada\xe7\xe3o ambiental e a favor do Marco Legal do Hidrog\xeanio Verde.',z='Discursos permanentes sobre justi\xe7a clim\xe1tica, preserva\xe7\xe3o das florestas e protagonismo sustent\xe1vel do Brasil.',A='Destina\xe7\xe3o de emendas e proposi\xe7\xe3o de medidas pelo desmatamento zero e recupera\xe7\xe3o de bacias hidrogr\xe1ficas.'):(v=`O percentual de ${c}% reflete apoio aos princ\xedpios da sustentabilidade, equilibrando posicionamentos ecol\xf3gicos com pautas de infraestrutura regional e desenvolvimento produtivo local.`,f=`O afastamento significativo de ${p}% decorre de concess\xf5es recorrentes \xe0 bancada do agroneg\xf3cio e condescend\xeancia com a simplifica\xe7\xe3o excessiva do licenciamento ambiental.`,b=['Votos favor\xe1veis a regimes simplificados de licenciamento ambiental para empreendimentos de minera\xe7\xe3o e pecu\xe1ria extensiva.','Apoio ou absten\xe7\xe3o na prorroga\xe7\xe3o de prazos de conformidade com o C\xf3digo Florestal e controle de defensivos qu\xedmicos.'],h='Votos favor\xe1veis a incentivos para energias renov\xe1veis e projetos de saneamento ecol\xf3gico.',z='Pronunciamentos destacando a concilia\xe7\xe3o entre preserva\xe7\xe3o ambiental e gera\xe7\xe3o de empregos verdes.',A='Iniciativas voltadas \xe0 gest\xe3o respons\xe1vel de res\xedduos s\xf3lidos e arboriza\xe7\xe3o urbana.');break;case'p4':c>=85?(v=`\xcdndice de ${c}% consolidado pela atua\xe7\xe3o sistem\xe1tica e firme em defesa do patrim\xf4nio p\xfablico nacional (Petrobras, BNDES, bancos p\xfablicos), soberania energ\xe9tica no Pr\xe9-Sal, prote\xe7\xe3o das riquezas minerais e fomento permanente \xe0 cultura e identidade brasileira.`,f=`O pequeno distanciamento de 100% (-${p}% de gap) decorre de absten\xe7\xf5es pontuais em sess\xf5es deliberativas de infraestruturas cr\xedticas e seguran\xe7a cibern\xe9tica de dados governamentais.`,b=['Necessidade de maior protagonismo legislativo em marcos regulat\xf3rios de soberania digital e prote\xe7\xe3o de sat\xe9lites e infraestruturas estrat\xe9gicas de dados.'],h='Votos nominais exemplares pela preserva\xe7\xe3o do controle estatal sobre riquezas estrat\xe9gicas e combate irrestrito a privatiza\xe7\xf5es.',z='Pronunciamentos enf\xe1ticos na tribuna em defesa da autodetermina\xe7\xe3o dos povos, soberania econ\xf4mica e patrim\xf4nio cultural brasileiro.',A='Coautoria e apoio ativo a leis de defesa das estatais p\xfablicas e prote\xe7\xe3o de ativos soberanos do pa\xeds.'):(v=`O percentual de ${c}% reflete diverg\xeancias em mat\xe9rias de modelos de gest\xe3o e concess\xf5es pontuais de infraestruturas nacionais \xe0 iniciativa privada.`,f=`O afastamento de ${p}% em rela\xe7\xe3o ao comprometimento pleno \xe9 motivado por votos favor\xe1veis a privatiza\xe7\xf5es ou concess\xf5es de ativos estrat\xe9gicos nacionais.`,b=['Vota\xe7\xf5es favor\xe1veis \xe0 concess\xe3o de portos, aeroportos e terminais log\xedsticos estrat\xe9gicos a cons\xf3rcios privados internacionais.','Aus\xeancia de oposi\xe7\xe3o en\xe9rgica a acordos que fragilizaram as exig\xeancias de conte\xfado nacional em contrata\xe7\xf5es p\xfablicas.'],h='Vota\xe7\xf5es com postura de ressalva ou absten\xe7\xe3o em mat\xe9rias de preserva\xe7\xe3o integral do monop\xf3lio de estatais.',z='Pronunciamentos com foco gen\xe9rico em rela\xe7\xf5es externas, com menor \xeanfase na defesa econ\xf4mica de grandes empresas estatais.',A='Menor atua\xe7\xe3o na proposi\xe7\xe3o de medidas de prote\xe7\xe3o patrimonial contra desnacionaliza\xe7\xe3o de cadeias produtivas.');break;case'p5':c>=85?(v=`O percentual de ${c}% expressa alt\xedssimo alinhamento com a reindustrializa\xe7\xe3o nacional soberana, apoio contundente \xe0 ci\xeancia, semicondutores e inova\xe7\xe3o verde (Nova Ind\xfastria Brasil), com atua\xe7\xe3o exemplar em defesa do er\xe1rio ao combater desonera\xe7\xf5es corporativas indiscriminadas que n\xe3o tragam contrapartidas socioecon\xf4micas e trabalhistas ao pa\xeds.`,f=`O afastamento residual de 100% (-${p}% de gap) decorre da prioriza\xe7\xe3o legislativa de temas sociais emergenciais (fome, sa\xfade e direitos civis), demandando maior dedica\xe7\xe3o em relatorias industriais de grande porte.`,b=['Necessidade de amplia\xe7\xe3o de projetos de lei de autoria pr\xf3pria voltados ao fomento de parques tecnol\xf3gicos p\xfablicos e intelig\xeancia artificial soberana.','Menor atua\xe7\xe3o em comiss\xf5es mistas especiais de bens de capital e infraestrutura pesada.'],h='Vota\xe7\xf5es nominais em defesa da ind\xfastria nacional soberana, com voto patri\xf3tico e firme contr\xe1rio a desonera\xe7\xf5es fiscais bilion\xe1rias a montadoras e multinacionais desprovidas de contrapartidas sociais, econ\xf4micas e trabalhistas para o pa\xeds.',z='Discursos enf\xe1ticos defendendo que a tecnologia nacional deve servir \xe0 emancipa\xe7\xe3o popular, inova\xe7\xe3o p\xfablica e gera\xe7\xe3o de empregos industriais dignos.',A='Apoio permanente \xe0 interioriza\xe7\xe3o da ci\xeancia, bolsas de pesquisa universit\xe1rias (Finep/CNPq) e fomento a cooperativas e pequenos neg\xf3cios inovadores.'):(v=`O \xedndice de ${c}% reflete atua\xe7\xe3o moderada na agenda de inova\xe7\xe3o e desenvolvimento produtivo nacional, com diverg\xeancias quanto a modelos de fomento.`,f=`O afastamento substancial de ${p}% dos 100% de comprometimento pleno \xe9 motivado por votos ou condescend\xeancia com desonera\xe7\xf5es fiscais bilion\xe1rias a grandes corpora\xe7\xf5es multinacionais sem exig\xeancia de contrapartidas sociais ou econ\xf4micas para o pa\xeds.`,b=['Aprova\xe7\xe3o ou complac\xeancia com pacotes de ren\xfancia fiscal e desonera\xe7\xf5es a montadoras multinacionais sem salvaguardas trabalhistas e sem garantia de novos investimentos locais.','Vota\xe7\xf5es que apoiaram contingenciamento de verbas em ag\xeancias p\xfablicas de ci\xeancia e tecnologia (Finep/CNPq).'],h='Apoio a incentivos corporativos gen\xe9ricos sem cl\xe1usulas de retorno produtivo comprovado para a economia do pa\xeds.',z='Discursos com \xeanfase no livre mercado sem exig\xeancia de metas ambientais ou tecnol\xf3gicas para as empresas beneficiadas.',A='Aus\xeancia de projetos de lei voltados a polos p\xfablicos de desenvolvimento tecnol\xf3gico e inova\xe7\xe3o nacional.');break;case'p6':c>=85?(v=`Comprometimento m\xe1ximo de ${c}% fundamentado no apoio contundente \xe0 Reforma Tribut\xe1ria com cashback aos mais pobres, taxa\xe7\xe3o de fundos exclusivos de super-ricos e offshores, amplia\xe7\xe3o da faixa de isen\xe7\xe3o do Imposto de Renda e pol\xedtica de valoriza\xe7\xe3o do Sal\xe1rio M\xednimo.`,f=`O afastamento de ${p}% \xe9 motivado pelas exce\xe7\xf5es e regimes tribut\xe1rios diferenciados concedidos a setores econ\xf4micos influentes para garantir a aprova\xe7\xe3o da Reforma Tribut\xe1ria.`,b=['Apoio a concess\xf5es e al\xedquotas reduzidas para segmentos financeiros e corporativos espec\xedficos durante a vota\xe7\xe3o do texto-base da Reforma.','Prorroga\xe7\xe3o escalonada da desonera\xe7\xe3o da folha de pagamento de setores intensivos em m\xe3o de obra sem auditoria pr\xe9via de impacto distributivo.'],h='Vota\xe7\xf5es exemplares a favor da progressividade tribut\xe1ria e justi\xe7a fiscal.',z='Discursos cont\xednuos pela aplica\xe7\xe3o rigorosa da capacidade contributiva (quem ganha mais deve pagar proporcionalmente mais).',A='Defesa ativa da isen\xe7\xe3o de tributos sobre a Cesta B\xe1sica Nacional e combate rigoroso \xe0 sonega\xe7\xe3o fiscal.'):(v=`Nota de ${c}% sustentada pelo apoio \xe0s diretrizes de aumento do sal\xe1rio m\xednimo e isen\xe7\xe3o tribut\xe1ria para trabalhadores de menor renda.`,f=`O afastamento de ${p}% deve-se \xe0 relut\xe2ncia e hesita\xe7\xe3o na defesa de tributa\xe7\xe3o direta sobre o grande patrim\xf4nio e heran\xe7as familiares bilion\xe1rias.`,b=['Falta de empenho e absten\xe7\xe3o na proposi\xe7\xe3o de al\xedquotas efetivas para o Imposto sobre Grandes Fortunas (IGF).','Apoio \xe0 manuten\xe7\xe3o de ren\xfancias e incentivos fiscais estaduais sem cl\xe1usulas rigorosas de retorno social e gera\xe7\xe3o de empregos.'],h='Votos favor\xe1veis \xe0 taxa\xe7\xe3o de offshores e fundos fechados.',z='Pronunciamentos enfatizando a necessidade de justi\xe7a distributiva e combate \xe0 concentra\xe7\xe3o de renda.',A='Articula\xe7\xe3o parlamentar por incentivos fiscais voltados \xe0 economia popular solid\xe1ria.');break;case'p7':c>=85?(v=`Classifica\xe7\xe3o destacada de ${c}% conquistada pela defesa hist\xf3rica e intransigente da demarca\xe7\xe3o de terras ind\xedgenas, titula\xe7\xe3o de quilombos, seguran\xe7a alimentar atrav\xe9s de Cozinhas Solid\xe1rias e prote\xe7\xe3o integral da inf\xe2ncia e da pessoa idosa.`,f=`O afastamento de ${p}% em rela\xe7\xe3o aos 100% decorre da morosidade e compromissos de concilia\xe7\xe3o com o agroneg\xf3cio em territ\xf3rios ind\xedgenas contestados judicialmente.`,b=['Ades\xe3o a mesas de concilia\xe7\xe3o no STF que postergaram a posse imediata de terras ind\xedgenas homologadas para evitar conflitos locais.','Menor press\xe3o parlamentar sobre dota\xe7\xf5es suplementares para indeniza\xe7\xe3o de benfeitorias em \xe1reas quilombolas.'],h='Votos nominais sistem\xe1ticos pela garantia dos recursos do BPC e fortalecimento do Minist\xe9rio dos Povos Ind\xedgenas.',z='Tribuna utilizada repetidamente como espa\xe7o de amplifica\xe7\xe3o das vozes das lideran\xe7as ind\xedgenas, quilombolas e da popula\xe7\xe3o de rua.',A='Apresenta\xe7\xe3o de proposi\xe7\xf5es e apoio or\xe7ament\xe1rio \xe0 agricultura familiar camponesa e comunidades tradicionais.'):(v=`\xcdndice de ${c}% refletindo engajamento nas pautas de inclus\xe3o e direitos de minorias sociais no parlamento.`,f=`O afastamento de ${p}% \xe9 consequ\xeancia da subordina\xe7\xe3o das pautas dos povos origin\xe1rios e comunidades tradicionais a acordos pol\xedticos regionais com o setor ruralista.`,b=['Votos omissos ou tolerantes com restri\xe7\xf5es ao direito de consulta pr\xe9via, livre e informada (Conven\xe7\xe3o 169 da OIT).','Baixa destina\xe7\xe3o de emendas parlamentares para infraestrutura em aldeias ind\xedgenas e comunidades quilombolas.'],h='Votos a favor de programas de acolhimento e assist\xeancia a fam\xedlias vulner\xe1veis.',z='Manifesta\xe7\xf5es p\xfablicas de apoio \xe0 preserva\xe7\xe3o dos territ\xf3rios tradicionais.',A='Atua\xe7\xe3o conjunta com frentes parlamentares em prol dos direitos das pessoas com defici\xeancia e idosos.');break;case'p8':c>=85?(v=`Desempenho de ${c}% pautado pelo combate veemente ao 'Or\xe7amento Secreto', defesa intransigente da Lei de Acesso \xe0 Informa\xe7\xe3o (LAI), fortalecimento da Controladoria-Geral da Uni\xe3o (CGU) e fomento \xe0 participa\xe7\xe3o popular direta nos or\xe7amentos p\xfablicos.`,f=`O candidato est\xe1 afastado em ${p}% dos 100% de pontua\xe7\xe3o por conviver com a sistem\xe1tica de emendas de bancada e comiss\xe3o essenciais para a articula\xe7\xe3o pol\xedtica parlamentar.`,b=['Participa\xe7\xe3o na indica\xe7\xe3o de emendas de comiss\xe3o com crit\xe9rios de transpar\xeancia que ainda demandam aprimoramento perante o STF.','Voto favor\xe1vel a altera\xe7\xf5es legislativas na Lei das Estatais que flexibilizaram regras de quarentena pol\xedtica em cargos de diretoria.'],h='Votos contr\xe1rios a manobras or\xe7ament\xe1rias opacas e favor\xe1veis ao rastreamento total do gasto p\xfablico.',z='Discursos rigorosos cobrando lisura, publicidade e integridade na contrata\xe7\xe3o p\xfablica.',A='Apoio a ferramentas digitais de presta\xe7\xe3o de contas abertas e ouvidorias cidad\xe3s.'):(v=`Pontua\xe7\xe3o de ${c}% orientada pelo respeito aos \xf3rg\xe3os de controle republicano e defesa da transpar\xeancia institucional.`,f=`O afastamento de ${p}% \xe9 justificado pelo alinhamento com manobras or\xe7ament\xe1rias de pouca transpar\xeancia e resist\xeancia a mecanismos abertos de controle cidad\xe3o.`,b=['Votos que dificultaram a identifica\xe7\xe3o p\xfablica dos autores e benefici\xe1rios de emendas parlamentares de relator.','Resist\xeancia \xe0 abertura de dados e \xe0 cria\xe7\xe3o de comit\xeas populares de auditoria de contratos de obras p\xfablicas.'],h='Ades\xe3o \xe0s normas de conformidade or\xe7ament\xe1ria e presta\xe7\xe3o de contas regulares.',z='Pronunciamentos sobre moderniza\xe7\xe3o administrativa e desburocratiza\xe7\xe3o dos servi\xe7os p\xfablicos.',A='Est\xedmulo a mecanismos de controle social e acompanhamento cidad\xe3o.');break;case'p9':c>=85?(v=`Comprometimento de excel\xeancia (${c}%) decorrente do hist\xf3rico irrevog\xe1vel de defesa do SUS 100% p\xfablico e gratuito, aprova\xe7\xe3o do Piso Nacional da Enfermagem, retomada do Mais M\xe9dicos e incentivo estatal \xe0 produ\xe7\xe3o de f\xe1rmacos pela Fiocruz e Butantan.`,f=`O afastamento de 100% (-${p}% de gap) decorre de votos favor\xe1veis \xe0 celebra\xe7\xe3o de contratos de gest\xe3o com Organiza\xe7\xf5es Sociais (OSs) privadas na administra\xe7\xe3o de unidades de sa\xfade.`,b=['Apoio \xe0 gest\xe3o terceirizada de hospitais e UPAs estaduais por meio de Organiza\xe7\xf5es Sociais de Sa\xfade, gerando atritos com categorias sindicais da enfermagem.','Manuten\xe7\xe3o das dedu\xe7\xf5es fiscais no Imposto de Renda para despesas m\xe9dicas em planos de sa\xfade e cl\xednicas privadas de alto custo.'],h='Votos nominais favor\xe1veis \xe0 recomposi\xe7\xe3o de verbas da sa\xfade p\xfablica e fortalecimento da aten\xe7\xe3o b\xe1sica.',z='Pronunciamentos constantes valorizando os trabalhadores da sa\xfade, a ci\xeancia e a vacina\xe7\xe3o universal.',A='Aloca\xe7\xe3o expressiva de emendas para hospitais p\xfablicos, policl\xednicas regionais e CAPS (sa\xfade mental).'):(v=`Nota de ${c}% consolidada pelo suporte a programas de expans\xe3o da rede ambulatorial e defesa do or\xe7amento constitucional do SUS.`,f=`O distanciamento de ${p}% em rela\xe7\xe3o aos 100% decorre de votos favor\xe1veis a tetos de gastos que limitaram o piso or\xe7ament\xe1rio constitucional da sa\xfade.`,b=['Votos alinhados \xe0 conten\xe7\xe3o de reajustes na tabela SUS para prestadores de servi\xe7os de m\xe9dia e alta complexidade.','Falta de empenho e votos de absten\xe7\xe3o em projetos de proibi\xe7\xe3o definitiva da comercializa\xe7\xe3o de planos de sa\xfade com cobertura segmentada.'],h='Votos favor\xe1veis \xe0 interioriza\xe7\xe3o m\xe9dica e gratuidade de rem\xe9dios essenciais.',z='Discursos p\xfablicos pelo enfrentamento de filas de exames e cirurgias eletivas.',A='Emendas e apoio a unidades b\xe1sicas de sa\xfade municipais.');break;case'p10':c>=85?(v=`\xcdndice de ${c}% firmado na concep\xe7\xe3o moderna de seguran\xe7a p\xfablica: foco em intelig\xeancia investigativa contra o crime organizado e mil\xedcias, per\xedcias cient\xedficas estruturadas, desarmamento respons\xe1vel e programas maci\xe7os de preven\xe7\xe3o social e primeiro emprego nas periferias.`,f=`O afastamento de ${p}% decorre de concess\xf5es a pautas de endurecimento penal e dificuldades de implantar metas vinculantes de desmilitariza\xe7\xe3o e controle da letalidade policial.`,b=['Voto favor\xe1vel a projetos de aumento de penas privativas de liberdade em per\xedodos de clamor p\xfablico, sem contrapartida de ressocializa\xe7\xe3o.','Menor cobran\xe7a sobre o uso obrigat\xf3rio de c\xe2meras corporais operacionais e protocolos transparentes em a\xe7\xf5es policiais de choque.'],h='Votos a favor do Sistema \xdanico de Seguran\xe7a P\xfablica (SUSP) e controle respons\xe1vel de arsenais e muni\xe7\xf5es.',z='Defesa p\xfablica da valoriza\xe7\xe3o profissional e sa\xfade mental dos policiais, aliada ao combate rigoroso \xe0 letalidade policial.',A='Projetos e emendas priorizando ilumina\xe7\xe3o p\xfablica, cultura de paz e centros de juventude em \xe1reas conflagradas.'):(v=`Classifica\xe7\xe3o de ${c}% refletindo compromisso com a ordem p\xfablica democr\xe1tica, integrando pol\xedcia eficiente com a\xe7\xf5es de cidadania.`,f=`O afastamento substancial de ${p}% \xe9 motivado pela ades\xe3o a discursos punitivistas tradicionais e toler\xe2ncia com a flexibiliza\xe7\xe3o do porte e posse de armas de fogo.`,b=['Votos contr\xe1rios a normas r\xedgidas de rastreamento de muni\xe7\xf5es e armamentos de grosso calibre em m\xe3os de CACs.','Oposi\xe7\xe3o a medidas estruturantes de desmilitariza\xe7\xe3o do policiamento ostensivo e reforma do sistema prisional.'],h='Apoio legislativo a fundos de seguran\xe7a p\xfablica e moderniza\xe7\xe3o de viaturas e equipamentos.',z='Pronunciamentos pela necessidade de intelig\xeancia policial contra a lavagem de dinheiro.',A='Apoio a projetos esportivos e profissionalizantes para jovens em risco social.');break;case'p11':c>=85?(v=`Comprometimento m\xe1ximo de ${c}% respaldado pelo voto hist\xf3rico e coautoria no Fundeb Permanente, valoriza\xe7\xe3o e cumprimento do Piso Salarial Nacional do Magist\xe9rio, expans\xe3o dos Institutos Federais e apoio integral \xe0 poupan\xe7a estudantil P\xe9-de-Meia.`,f=`O candidato est\xe1 afastado em ${p}% dos 100% de comprometimento pleno em raz\xe3o de concess\xf5es de partilha de recursos p\xfablicos com institui\xe7\xf5es privadas conveniadas e lentid\xe3o na fiscaliza\xe7\xe3o do piso salarial docente nos munic\xedpios.`,b=['Votos favor\xe1veis \xe0 inclus\xe3o de institui\xe7\xf5es filantr\xf3picas e confessionais no c\xf4mputo de matr\xedculas financiadas pelo Fundeb.','Menor enfrentamento de governos aliados que descumprem a atualiza\xe7\xe3o anual do Piso Salarial Nacional dos Professores.'],h='Votos 100% favor\xe1veis a recursos para educa\xe7\xe3o p\xfablica em tempo integral e alimenta\xe7\xe3o escolar nutritiva.',z='Discursos incisivos na tribuna em defesa da carreira docente, autonomia universit\xe1ria e infraestrutura digna nas escolas.',A='Destina\xe7\xe3o maci\xe7a de emendas parlamentares para climatiza\xe7\xe3o de salas de aula, laborat\xf3rios cient\xedficos e transporte escolar.'):c>=65?(v=`\xcdndice consistente de ${c}% assegurado pelo apoio \xe0s pautas priorit\xe1rias da educa\xe7\xe3o b\xe1sica, amplia\xe7\xe3o de creches e valoriza\xe7\xe3o dos profissionais da rede p\xfablica de ensino.`,f=`O afastamento de ${p}% dos 100% de comprometimento pleno \xe9 motivado pela toler\xe2ncia com a terceiriza\xe7\xe3o na gest\xe3o escolar e apoio mitigado a investimentos em universidades p\xfablicas.`,b=['Apoio ou votos de absten\xe7\xe3o em projetos de terceiriza\xe7\xe3o e parcerias p\xfablico-privadas na gest\xe3o administrativa de unidades escolares.','Falta de empenho priorit\xe1rio na aloca\xe7\xe3o de emendas para reformas de laborat\xf3rios e climatiza\xe7\xe3o em escolas de periferia.'],h='Votos favor\xe1veis a or\xe7amentos suplementares para universidades e escolas p\xfablicas.',z='Pronunciamentos destacando a educa\xe7\xe3o como vetor essencial de redu\xe7\xe3o das desigualdades sociais.',A='Apoio a programas municipais de refor\xe7o pedag\xf3gico e fornecimento de material escolar.'):(v=`Pontua\xe7\xe3o de ${c}% refletindo posicionamento gen\xe9rico em favor da educa\xe7\xe3o, sem lideran\xe7a ou apresenta\xe7\xe3o de proposi\xe7\xf5es or\xe7ament\xe1rias expressivas no setor.`,f=`Afastamento cr\xedtico de ${p}% provocado pelo apoio a cortes no or\xe7amento da educa\xe7\xe3o e condescend\xeancia com programas de censura \xe0 autonomia pedag\xf3gica dos professores.`,b=['Votos favor\xe1veis a contingenciamentos de verbas nas universidades federais e institutos federais de educa\xe7\xe3o.','Apoio a projetos de privatiza\xe7\xe3o de escolas e medidas restritivas \xe0 liberdade de c\xe1tedra dos educadores.'],h='Ades\xe3o moderada aos votos de bancada em mat\xe9rias educacionais.',z='Manifesta\xe7\xf5es espor\xe1dicas de apoio aos estudantes e professores.',A='Participa\xe7\xe3o secund\xe1ria em comiss\xf5es tem\xe1ticas de educa\xe7\xe3o e cultura.');break;case'p12':c>=85?(v=`\xcdndice de ${c}% consolidado na defesa irrestrita dos direitos laborais, combate \xe0 precariza\xe7\xe3o, prote\xe7\xe3o a trabalhadores de aplicativos, valoriza\xe7\xe3o das conven\xe7\xf5es coletivas e amplia\xe7\xe3o do emprego com carteira assinada.`,f=`O afastamento de ${p}% dos 100% de comprometimento decorre de flexibiliza\xe7\xf5es pontuais em regimes especiais de trabalho e ades\xe3o a acordos parlamentares sobre jornadas em setores espec\xedficos.`,b=['Votos de concilia\xe7\xe3o partid\xe1ria em mat\xe9rias de desregulamenta\xe7\xe3o transit\xf3ria de setores sazonais.','Menor protagonismo na fiscaliza\xe7\xe3o direta das condi\xe7\xf5es de trabalho degradante em cadeias produtivas terceirizadas.'],h='Vota\xe7\xf5es 100% alinhadas \xe0 regula\xe7\xe3o protetiva do trabalho em plataformas e garantia do direito de negocia\xe7\xe3o coletiva.',z='Pronunciamentos firmes em defesa dos direitos conquistados pela CLT e combate \xe0 terceiriza\xe7\xe3o precarizante.',A='Articula\xe7\xe3o de projetos de requalifica\xe7\xe3o profissional, intermedia\xe7\xe3o p\xfablica de m\xe3o de obra e frentes em defesa do trabalho decente.'):c>=65?(v=`Comprometimento consistente de ${c}% com a defesa do emprego formal e valoriza\xe7\xe3o da classe trabalhadora, mantendo postura favor\xe1vel aos direitos sociais b\xe1sicos.`,f=`Afastamento de ${p}% motivado por concess\xf5es a reformas de flexibiliza\xe7\xe3o trabalhista e aus\xeancia de proposi\xe7\xf5es de autoria pr\xf3pria sobre novas rela\xe7\xf5es laborais digitais.`,b=['Absten\xe7\xe3o ou votos favor\xe1veis a projetos que limitam a atua\xe7\xe3o fiscalizat\xf3ria da Justi\xe7a do Trabalho.','Pouca iniciativa legislativa pr\xf3pria no enfrentamento \xe0 informalidade e precariza\xe7\xe3o de entregadores e motoristas de aplicativo.'],h='Apoio \xe0 maior parte das mat\xe9rias de prote\xe7\xe3o social e direitos previdenci\xe1rios dos trabalhadores.',z='Manifesta\xe7\xf5es p\xfablicas de apoio aos direitos trabalhistas em datas comemorativas e audi\xeancias p\xfablicas.',A='Participa\xe7\xe3o moderada em comiss\xf5es de trabalho e previd\xeancia social.'):(v=`Pontua\xe7\xe3o de ${c}% indicando atua\xe7\xe3o que privilegia a desregulamenta\xe7\xe3o e flexibiliza\xe7\xe3o das leis trabalhistas em detrimento da prote\xe7\xe3o social do empregado.`,f=`Afastamento cr\xedtico de ${p}% decorrente do apoio sistem\xe1tico ao desmonte da CLT, terceiriza\xe7\xe3o irrestrita e enfraquecimento das entidades sindicais.`,b=['Vota\xe7\xf5es favor\xe1veis \xe0 amplia\xe7\xe3o irrestrita da terceiriza\xe7\xe3o e enfraquecimento da fiscaliza\xe7\xe3o do trabalho.','Defesa da preval\xeancia do negociado sobre o legislado com perda de garantias hist\xf3ricas fundamentais.'],h='Votos favor\xe1veis a medidas de flexibiliza\xe7\xe3o de direitos trabalhistas.',z='Discursos que tratam prote\xe7\xf5es trabalhistas como entraves burocr\xe1ticos ao desenvolvimento.',A='Apoio a projetos de lei que restringem a gratuidade da Justi\xe7a do Trabalho.');break;default:c>=85?(v=`Comprometimento de ${c}% focado no fortalecimento de micro e pequenos empres\xe1rios, MEIs, desonera\xe7\xe3o fiscal atrelada a metas comprovadas de emprego, desburocratiza\xe7\xe3o e democratiza\xe7\xe3o do microcr\xe9dito orientado.`,f=`O afastamento de ${p}% em rela\xe7\xe3o ao comprometimento pleno deve-se a concess\xf5es na concess\xe3o de subs\xeddios a grandes grupos econ\xf4micos e lentid\xe3o no aperfei\xe7oamento dos tetos do Simples Nacional.`,b=['Apoio a ren\xfancias fiscais gen\xe9ricas sem contrapartidas transparentes de gera\xe7\xe3o l\xedquida de postos de trabalho.','Votos de acomoda\xe7\xe3o or\xe7ament\xe1ria que restringiram o volume de cr\xe9dito garantido pelo Pronampe a taxas subsidiadas.'],h='Vota\xe7\xf5es favor\xe1veis \xe0 expans\xe3o do Simples Nacional, prote\xe7\xe3o ao microcr\xe9dito e desonera\xe7\xe3o com contrapartidas sociais.',z='Pronunciamentos em defesa do pequeno empreendedor como motor da economia local e exig\xeancia de transpar\xeancia nos incentivos fiscais.',A='Proposi\xe7\xf5es e emendas parlamentares voltadas \xe0 simplifica\xe7\xe3o tribut\xe1ria e capacita\xe7\xe3o de microempreendedores com o Sebrae.'):c>=65?(v=`\xcdndice consistente de ${c}% com apoio \xe0s micro e pequenas empresas e incentivo ao empreendedorismo produtivo, mantendo cautela fiscal respons\xe1vel.`,f=`Afastamento de ${p}% decorrente de apoio a benef\xedcios tribut\xe1rios opacos e baixa \xeanfase na simplifica\xe7\xe3o regulat\xf3ria para novos neg\xf3cios de periferia.`,b=['Voto favor\xe1vel \xe0 prorroga\xe7\xe3o de regimes especiais de desonera\xe7\xe3o sem exig\xeancia de metas de investimento e inova\xe7\xe3o.','Pouca atua\xe7\xe3o em projetos de cr\xe9dito orientado para microempreendedores informais e jovens empreendedores.'],h='Apoio a medidas de socorro financeiro e desburocratiza\xe7\xe3o para microempresas.',z='Defesa de ambiente de neg\xf3cios favor\xe1vel aliado \xe0 responsabilidade or\xe7ament\xe1ria.',A='Apoio a iniciativas locais de feiras de neg\xf3cios e cooperativas produtivas.'):(v=`Pontua\xe7\xe3o de ${c}% refletindo atua\xe7\xe3o pautada em desonera\xe7\xf5es fiscais indiscriminadas para grandes conglomerados, sem compromisso com contrapartidas sociais ou apoio ao microempreendedor de base.`,f=`Afastamento cr\xedtico de ${p}% causado pelo direcionamento de benef\xedcios fiscais a setores privilegiados e desmonte de fundos de aval para pequenos neg\xf3cios.`,b=['Aprova\xe7\xe3o de subs\xeddios e isen\xe7\xf5es sem transpar\xeancia or\xe7ament\xe1ria ou crit\xe9rios de retorno social.','Oposi\xe7\xe3o a medidas de prote\xe7\xe3o ao microempreendedor individual e fortalecimento do microcr\xe9dito popular.'],h='Votos favor\xe1veis a privil\xe9gios fiscais setoriais concentrados em grandes corpora\xe7\xf5es.',z='Discursos que priorizam incentivos corporativos em detrimento do apoio aos micro e pequenos produtores.',A='Aus\xeancia de projetos de incentivo ao ecossistema de startups e empreendedorismo comunit\xe1rio.')}c<=35&&(v=`Pontua\xe7\xe3o de ${c}% (Cr\xedtica/Restrita): reflete alinhamento hist\xf3rico com vota\xe7\xf5es de conten\xe7\xe3o do investimento p\xfablico, apoio a privatiza\xe7\xf5es e flexibiliza\xe7\xe3o de garantias sociais contr\xe1rias \xe0s diretrizes progressistas deste pilar.`,f=`O candidato est\xe1 afastado em ${p}% do comprometimento pleno por atuar em frontal oposi\xe7\xe3o program\xe1tica e legislativa \xe0s diretrizes sociais e p\xfablicas deste pilar progressista.`,b=['Vota\xe7\xf5es nominais sistematicamente favor\xe1veis \xe0 redu\xe7\xe3o do papel regulador e redistributivo do Estado.','Defesa reiterada de privatiza\xe7\xf5es, desregulamenta\xe7\xe3o trabalhista e redu\xe7\xe3o de investimentos or\xe7ament\xe1rios obrigat\xf3rios.','Alinhamento com medidas de austeridade fiscal que impactam diretamente os servi\xe7os p\xfablicos prestados \xe0 popula\xe7\xe3o.'],h='Votos frequentes contr\xe1rios \xe0 amplia\xe7\xe3o de despesas p\xfablicas sociais e a favor de regimes desregulados.',z='Discursos defendendo austeridade fiscal estrita e primazia de mecanismos de mercado sobre servi\xe7os p\xfablicos.',A='Apoio a medidas que limitam o papel redistributivo e orientador do Estado na tem\xe1tica.');0===p&&(f='Comprometimento pleno (100%): o candidato n\xe3o possui registros de diverg\xeancia, absten\xe7\xe3o prejudicial ou oposi\xe7\xe3o nas vota\xe7\xf5es, discursos e proposi\xe7\xf5es auditadas deste pilar.',b=[]);return{resumo:v,gap100:p,motivoAfastamento100:f,pontosAfastamento:b,criterios:[{nome:'Vota\xe7\xf5es Nominais no Parlamento',peso:40,pontuacao:t,aderencia:o(t),detalhe:h},{nome:'Pronunciamentos & Defesa na Tribuna',peso:30,pontuacao:n,aderencia:o(n),detalhe:z},{nome:'Posturas, Projetos de Lei e A\xe7\xf5es Pr\xe1ticas',peso:30,pontuacao:u,aderencia:o(u),detalhe:A}],formula:`C\xe1lculo Audit\xe1vel: (Vota\xe7\xf5es: ${t}% \xd7 40%) + (Discursos: ${n}% \xd7 30%) + (Posturas: ${u}% \xd7 30%) = ${c}%`,metodologia:'Auditoria c\xedvica baseada em registros oficiais da C\xe2mara dos Deputados, Senado Federal e Portal de Dados Abertos do TSE (dadosabertos.tse.jus.br). Avalia a converg\xeancia de votos nominais, pronunciamentos na tribuna e autoria de propostas legislativas.'}}},904,[]);
