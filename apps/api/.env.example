# ─── Database ───────────────────────────────────────
DATABASE_URL=postgresql://np_user:np_password@localhost:5432/norte_progressista

# ─── Supabase ──────────────────────────────────────
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...          # Service role key (server-only)
SUPABASE_JWT_SECRET=your-jwt-secret  # From Supabase Dashboard > Settings > API

# ─── Matching Service ─────────────────────────────
MATCHING_SERVICE_URL=http://localhost:8001
MATCHING_API_KEY=local-dev-key-change-in-production

# ─── Redis ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── External APIs ────────────────────────────────
TSE_API_URL=https://divulgacao.tse.jus.br
VIA_CEP_URL=https://viacep.com.br
IBGE_URL=https://servicodados.ibge.gov.br/api/v1

# ─── Sentry ────────────────────────────────────────
SENTRY_DSN=

# ─── App ──────────────────────────────────────────
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:8081
