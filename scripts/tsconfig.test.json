{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "react-native": ["./test-shims/react-native.ts"],
      "expo-file-system": ["./test-shims/expo-file-system.ts"],
      "expo-constants": ["./test-shims/expo-constants.ts"]
    }
  }
}
